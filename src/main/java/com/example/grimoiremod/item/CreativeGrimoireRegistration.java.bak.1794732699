package com.example.grimoiremod.item;

import com.example.grimoiremod.GrimoireMod;
import net.minecraft.core.registries.BuiltInRegistries;
import net.minecraft.core.registries.Registries;
import net.minecraft.resources.ResourceLocation;
import net.minecraft.world.item.CreativeModeTabs;
import net.minecraft.world.item.Item;
import net.neoforged.bus.api.SubscribeEvent;
import net.neoforged.fml.common.EventBusSubscriber;
import net.neoforged.neoforge.event.BuildCreativeModeTabContentsEvent;
import net.neoforged.neoforge.registries.RegisterEvent;

/**
 * Регистрирует творческий гримуар без DeferredRegister.
 *  - RegisterEvent(ITEM)              → register(Registry, RL, Supplier)
 *  - BuildCreativeModeTabContentsEvent → добавление в креатив-таб
 *
 * Само Item доступно по RL через BuiltInRegistries.ITEM.getOrThrow(id).
 */
@EventBusSubscriber(modid = GrimoireMod.MOD_ID, bus = EventBusSubscriber.Bus.MOD)
public final class CreativeGrimoireRegistration {
    private CreativeGrimoireRegistration() {}

    public static final ResourceLocation CREATIVE_GRIMOIRE_ID =
            ResourceLocation.fromNamespaceAndPath(GrimoireMod.MOD_ID, "creative_grimoire");

    @SubscribeEvent
    public static void onRegister(RegisterEvent event) {
        if (!event.getRegistryKey().equals(Registries.ITEM)) return;
        event.register(Registries.ITEM, CREATIVE_GRIMOIRE_ID,
                () -> new CreativeGrimoireItem(new Item.Properties().stacksTo(1)));
    }

    @SubscribeEvent
    public static void onBuildContents(BuildCreativeModeTabContentsEvent event) {
        if (event.getTabKey() != CreativeModeTabs.TOOLS_AND_UTILITIES) return;
        event.accept(BuiltInRegistries.ITEM.getOrThrow(CREATIVE_GRIMOIRE_ID));
    }
}
